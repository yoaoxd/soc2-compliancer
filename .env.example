# The API reads exported environment variables; it does not load this file itself.
# Copy to .env, generate two DIFFERENT secrets, and export the values before startup.
HTTP_ADDR=:8080
DATABASE_URL=postgres://soc2:soc2@localhost:5433/soc2?sslmode=disable
JWT_SECRET=
JWT_TTL_HOURS=24
ENCRYPTION_KEY=
# Optional AWS KMS key ID/ARN; if set, KMS wraps encryption keys instead.
ENCRYPTION_KEK_ID=
TEMPLATES_DIR=../templates
LOG_LEVEL=info
