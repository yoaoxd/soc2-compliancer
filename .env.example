# Copy to .env and adjust. The API reads env vars directly (see api/internal/config).
HTTP_ADDR=:8080
DATABASE_URL=postgres://soc2:soc2@localhost:5433/soc2?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=24
ENCRYPTION_KEY=change-me-to-another-long-random-string
TEMPLATES_DIR=../templates
LOG_LEVEL=info